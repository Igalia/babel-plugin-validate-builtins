{
  "sourceType": "unambiguous",
  "presets": [
    "@babel/preset-env",
    [
      "@babel/preset-typescript",
      {
        "rewriteImportExtensions": true
      }
    ]
  ],
  "plugins": ["./scripts/babel-plugin-compat-core-import.cjs"],
  "targets": {
    "node": "current"
  },
  "env": {
    "production": {
      "targets": {
        "node": "20.19"
      }
    }
  }
}
